# Text LLM (CV parsing, transcript scoring, the text-CLI's follow-ups —
# see agent/llm_client.py). Defaults to a local Ollama server: install
# Ollama (https://ollama.com), then `ollama pull qwen2.5:7b-instruct` and
# `ollama pull nomic-embed-text`. LLM_API_KEY is a dummy value Ollama
# doesn't check — point LLM_BASE_URL at OpenAI (or any other
# OpenAI-compatible endpoint) with a real key to use that instead.
LLM_BASE_URL = "http://localhost:11434/v1"
LLM_API_KEY = "ollama"
LLM_CHAT_MODEL = "qwen2.5:7b-instruct"
# 768-dimensional — must match packages/db/prisma/schema.prisma's
# Question.embedding column size. Changing this to a model with a
# different output size needs a matching migration.
LLM_EMBEDDING_MODEL = "nomic-embed-text"

# Voice pipeline (agent/voice/pipeline.py) — fully local, no API keys:
# Ollama for the LLM (reuses LLM_BASE_URL above), MLX Whisper for STT
# (Apple Silicon only — see agent/voice/pipeline.py's comment if you need
# the cross-platform faster-whisper variant instead), Kokoro for TTS
# (needs `brew install espeak-ng`). All three download their model files
# to a local cache on first use.
VOICE_LLM_MODEL = "qwen2.5:7b-instruct"
VOICE_STT_MODEL = "mlx-community/distil-whisper-large-v3"
VOICE_TTS_VOICE = "af_heart"

# Same Postgres database packages/db migrates — this app reads the role
# blueprint and question bank directly via psycopg (see agent/db.py), not
# through Prisma.
DATABASE_URL = "postgresql://postgres:postgres@localhost:5432/interview"

# Redis — the "agent-jobs" BullMQ queue apps/api's sessionService enqueues
# to (see agent/voice/consumer.py).
REDIS_URL = "redis://localhost:6379"

# apps/api's own base URL, and the shared secret it requires on the
# transcript webhook (see agent/voice/webhook_client.py and
# apps/api/.env.example's matching AGENT_WEBHOOK_SECRET — must be the same
# value on both sides).
API_URL = "http://localhost:3001"
AGENT_WEBHOOK_SECRET = "replace-with-a-long-random-secret"

# Host/port the voice server (agent/voice/server.py) listens on for the
# candidate's browser WebRTC connection.
AGENT_HOST = "0.0.0.0"
AGENT_PORT = 7860
