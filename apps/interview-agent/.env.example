# Text LLM (CV parsing, transcript scoring, the text-CLI's follow-ups, and
# — via VOICE_LLM_MODEL below — the live interview conversation itself.
# See agent/llm_client.py). Any OpenAI-compatible /v1 server works, chosen
# by LLM_BASE_URL:
#
# Option A — Ollama (simplest, one server does chat + embeddings both):
#   Install Ollama (https://ollama.com), then
#   `ollama pull qwen2.5:7b-instruct` and `ollama pull nomic-embed-text`.
#   LLM_API_KEY = "ollama" is a dummy value Ollama doesn't check.
#     LLM_BASE_URL = "http://localhost:11434/v1"
#     LLM_API_KEY = "ollama"
#     LLM_CHAT_MODEL = "qwen2.5:7b-instruct"
#
# Option B — LM Studio: load a chat model, then Developer tab -> Start
#   Server. LM Studio's per-model server picks a port at random each time
#   it starts (NOT always 1234) and enforces its own API key — copy both
#   from the server tab (or, on macOS, `ps aux | grep llama-server` shows
#   the --host/--port/--api-key it was launched with) and re-check them
#   after restarting LM Studio, since the port isn't stable across
#   restarts. LM Studio's server only serves the one model it was started
#   with — no embedding model alongside it — so EMBEDDING_BASE_URL below
#   needs to point somewhere else (Ollama, or a second LM Studio instance
#   with an embedding model loaded).
#     LLM_BASE_URL = "http://127.0.0.1:PORT_FROM_LM_STUDIO/v1"
#     LLM_API_KEY = "KEY_FROM_LM_STUDIO"
#     LLM_CHAT_MODEL = "your-loaded-model-name"
LLM_BASE_URL = "http://localhost:11434/v1"
LLM_API_KEY = "ollama"
LLM_CHAT_MODEL = "qwen2.5:7b-instruct"

# Embeddings get their own endpoint since whatever's serving LLM_BASE_URL
# may not have an embedding model loaded (see LM Studio note above).
# Defaults to LLM_BASE_URL/LLM_API_KEY when unset — correct for Ollama,
# must be overridden (e.g. back to Ollama) if LLM_BASE_URL is LM Studio.
EMBEDDING_BASE_URL = "http://localhost:11434/v1"
EMBEDDING_API_KEY = "ollama"
# 768-dimensional — must match packages/db/prisma/schema.prisma's
# Question.embedding column size. Changing this to a model with a
# different output size needs a matching migration.
LLM_EMBEDDING_MODEL = "nomic-embed-text"

# Voice pipeline (agent/voice/pipeline.py) — LLM reuses LLM_BASE_URL/
# LLM_API_KEY above; STT and TTS are fully local either way, no server or
# API key involved: MLX Whisper for STT (Apple Silicon only — see
# agent/voice/pipeline.py's comment if you need the cross-platform
# faster-whisper variant instead), Kokoro for TTS (needs
# `brew install espeak-ng`). Both download their model files to a local
# cache on first use.
#
# If VOICE_LLM_MODEL is a "thinking" model (Qwen3's whole family does this
# by default — it'll add several seconds of hidden reasoning before every
# spoken turn otherwise), agent/voice/pipeline.py's system prompt already
# sends a "/no_think" directive to suppress that; harmless no-op text for
# a model that doesn't recognize it.
VOICE_LLM_MODEL = "qwen2.5:7b-instruct"
VOICE_STT_MODEL = "mlx-community/distil-whisper-large-v3"
VOICE_TTS_VOICE = "af_heart"

# Same Postgres database packages/db migrates — this app reads the role
# blueprint and question bank directly via psycopg (see agent/db.py), not
# through Prisma.
DATABASE_URL = "postgresql://postgres:postgres@localhost:5432/interview"

# Redis — the "agent-jobs" BullMQ queue apps/api's sessionService enqueues
# to (see agent/voice/consumer.py).
REDIS_URL = "redis://localhost:6379"

# apps/api's own base URL, and the shared secret it requires on the
# transcript webhook (see agent/voice/webhook_client.py and
# apps/api/.env.example's matching AGENT_WEBHOOK_SECRET — must be the same
# value on both sides).
API_URL = "http://localhost:3001"
AGENT_WEBHOOK_SECRET = "replace-with-a-long-random-secret"

# Host/port the voice server (agent/voice/server.py) listens on for the
# candidate's browser WebRTC connection.
AGENT_HOST = "0.0.0.0"
AGENT_PORT = 7860
