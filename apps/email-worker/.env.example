# Redis connection the BullMQ worker listens on.
REDIS_URL = "redis://localhost:6379"

# SMTP connection for outgoing candidate emails (see
# packages/email/src/mailer.ts). Defaults below match docker-compose.dev.yml's
# mailhog service — no auth needed, view sent mail at http://localhost:8025.
SMTP_HOST = "localhost"
SMTP_PORT = 1025
SMTP_SECURE = "false"
SMTP_USER = ""
SMTP_PASS = ""
SMTP_FROM = "Interview Platform <no-reply@interview-platform.local>"
