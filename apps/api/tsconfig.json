{
  "extends": "@repo/typescript-config/api.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // @repo/email is consumed as TS source (see its package.json "exports")
    // and includes .tsx React Email templates, so this project's own
    // compiler options apply when tsc walks into it.
    "jsx": "react-jsx",
    "lib": ["es2022", "DOM"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
