# Port the API server listens on.
API_PORT = 3001

# "development" | "production" — affects cookie settings (secure/sameSite,
# see src/lib/jwt.ts) and which CORS origin is allowed (see
# src/middleware/corsMiddleware.ts).
API_NODE_ENV = "development"

# Secret used to sign/verify auth JWTs (see src/lib/jwt.ts). Generate a real
# random value for each environment — never reuse this example, never
# commit the real one.
API_JWT_SECRET = "replace-with-a-long-random-secret"

# This server's own publicly reachable base URL — used to build absolute
# URLs for uploaded CVs (see src/service/candidateService.ts), since a CV's
# URL must resolve from wherever it's fetched from (e.g. by
# apps/interview-agent), not just from the API's own origin.
API_PUBLIC_URL = "http://localhost:3001"

# Vite dev server port the dashboard runs on — used by corsMiddleware.ts in
# development.
DASHBOARD_PORT = 3002

# The dashboard's own publicly reachable base URL — used to build the v1
# browser-room meeting URL (see src/lib/meetingProvider.ts). Browser-
# reachable, not the internal service hostname, since the candidate's
# browser opens this link directly from the meeting-link email.
DASHBOARD_PUBLIC_URL = "http://localhost:3002"

# Redis connection for both the email queue (via @repo/email) and this
# API's own agent-jobs queue (see src/lib/agentQueue.ts).
REDIS_URL = "redis://localhost:6379"

# Shared secret apps/interview-agent must send back (as the
# X-Agent-Webhook-Secret header) when it posts a finished transcript — see
# src/middleware/webhookAuthMiddleware.ts. Must match the same-named
# variable in apps/interview-agent/.env.example.
AGENT_WEBHOOK_SECRET = "replace-with-a-long-random-secret"

# Postgres connection string. Not read from this file directly — it lives in
# packages/db/.env instead (see that package's own .env.example) because
# packages/db resolves it relative to its own location, not the api app's.
