# Base URL the dashboard's browser calls for the API. Point this at wherever
# apps/api is reachable *from the browser* — e.g. http://localhost:3001 for
# local dev.
#
# Inlined into the built JS bundle at build time (Vite prefix) — changing it
# requires a rebuild, not just a container restart.
VITE_API_ENDPOINT_URL = "http://localhost:3001"
