{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://interview-platform/schemas/email-job.schema.json",
  "title": "EmailJob",
  "description": "Mirrors packages/mailer/src/types.ts's EmailJob union by hand — this is the payload shape apps/api enqueues (via packages/mailer's client.ts) and packages/mailer's own BullMQ worker consumes. Kept here as plain JSON Schema, not a TS import, since a future non-TS consumer (or a schema-validation step at the queue boundary) needs a language-agnostic description of the job shape.",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": { "const": "interview-invite" },
        "data": { "$ref": "#/$defs/baseEmailData" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": { "const": "interview-followup" },
        "data": { "$ref": "#/$defs/baseEmailData" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": { "const": "interview-meeting-link" },
        "data": {
          "allOf": [
            { "$ref": "#/$defs/baseEmailData" },
            {
              "type": "object",
              "required": ["meetingUrl"],
              "properties": {
                "meetingUrl": { "type": "string", "format": "uri" }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": { "const": "report-ready" },
        "data": {
          "type": "object",
          "required": [
            "to",
            "candidateName",
            "roleName",
            "sessionId",
            "sessionUrl"
          ],
          "properties": {
            "to": { "type": "string", "format": "email" },
            "candidateName": { "type": "string" },
            "roleName": { "type": "string" },
            "sessionId": { "type": "integer" },
            "sessionUrl": { "type": "string", "format": "uri" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "baseEmailData": {
      "type": "object",
      "required": ["to", "candidateName", "roleName", "scheduledAt"],
      "properties": {
        "to": { "type": "string", "format": "email" },
        "candidateName": { "type": "string" },
        "roleName": { "type": "string" },
        "scheduledAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    }
  }
}
