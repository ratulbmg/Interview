generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// NOTE: InterviewSessionStatus and QuestionDifficulty below are mirrored by
// hand in packages/enums/src/index.ts, the package the API, email-worker
// and dashboard import these from. Prisma's schema format can't import
// external values, so if you add, rename, or remove a value here, make the
// matching change there too (see packages/db/scripts/sync-enums.ts).

/// An InterviewSession's lifecycle. SCHEDULED is the state a session is
/// created in; INVITE_SENT is set the moment "Send Invite" is pressed.
enum InterviewSessionStatus {
  SCHEDULED
  INVITE_SENT
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

/// Recruiters — the only users of the dashboard. Candidates never log in.
model User {
  id           Int      @id @default(autoincrement())
  uniqueId     String   @unique
  name         String   @db.VarChar(100)
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("users")
}

/// A candidate is added independently of any interview — no age, no role.
/// Role and scheduling live on InterviewSession; one candidate can have
/// many sessions. `uniqueId` is generated by the system at creation time
/// (see apps/api's candidate service, Phase 3) — combined with the
/// `email @unique` constraint below, it's what keeps the same person from
/// ending up with two profiles.
model Candidate {
  id           Int      @id @default(autoincrement())
  uniqueId     String   @unique
  email        String   @unique
  name         String?  @db.VarChar(100)
  cvUrl        String
  cvParsedJson Json?
  createdAt    DateTime @default(now())

  sessions InterviewSession[]

  @@map("candidates")
}

/// A role's fixed interview blueprint — an ordered array of slot objects,
/// e.g. [{ "slot": "opener" }, { "slot": "core_competency", "competency":
/// "React" }, ...]. Which slot names exist is documented in
/// packages/db/src/seed.ts alongside the two seeded roles.
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String
  blueprint   Json
  createdAt   DateTime @default(now())

  sessions InterviewSession[]

  @@map("roles")
}

/// The shared question bank. Not owned by a single Role — the same bank is
/// filtered by `competency` (either a blueprint slot name like "opener", or
/// a specific skill like "React" for "core_competency" slots) and
/// `difficulty`, then ranked by CV relevance via `embedding`, at selection
/// time (see apps/interview-agent's question_selector.py, Phase 2).
model Question {
  id          Int                 @id @default(autoincrement())
  text        String
  competency  String
  difficulty  QuestionDifficulty
  tags        String[]
  // pgvector column. Prisma Client has no first-class query API for it
  // (declared Unsupported on purpose) — cosine-similarity ranking happens
  // via raw SQL from apps/interview-agent, not through this ORM. 768 dims
  // matches nomic-embed-text, the default local embedding model (see
  // apps/interview-agent's agent/config.py — LLM_EMBEDDING_MODEL). Swapping
  // to a model with a different output size needs a matching migration.
  embedding   Unsupported("vector(768)")?
  timesAsked  Int                 @default(0)
  lastAskedAt DateTime?
  createdAt   DateTime            @default(now())

  @@map("questions")
}

/// Role and schedule live here, not on Candidate — a second, separate
/// recruiter action from adding the candidate. Pressing "Send Invite" is
/// the last thing the recruiter has to do; everything after (see
/// packages/email and the scheduler, Phases 4-5) runs on its own.
model InterviewSession {
  id             Int                    @id @default(autoincrement())
  candidateId    Int
  candidate      Candidate              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  roleId         Int
  role           Role                   @relation(fields: [roleId], references: [id])
  status         InterviewSessionStatus @default(SCHEDULED)
  scheduledAt    DateTime
  meetingUrl     String?
  transcript     Json?
  reportJson     Json?
  /// Set the moment the candidate confirms the recording/AI-evaluation
  /// notice at the start of the call (see apps/interview-agent's
  /// agent/voice/server.py, Phase 8) — null means either the interview
  /// hasn't started or consent was never explicitly logged.
  consentGivenAt DateTime?
  createdAt      DateTime               @default(now())

  @@map("sessions")
}
