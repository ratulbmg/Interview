# Postgres connection string. Resolved relative to this file's own location
# (see src/index.ts), which is why it lives here instead of in apps/api's
# .env even though apps/api is the only app that talks to the database
# directly.
#
# No Docker/local Postgres install needed — point this at a Postgres
# instance you control, e.g. a free Neon (serverless Postgres) branch,
# which also supports the `vector` extension this schema needs
# (`extensions = [vector]` in packages/db/prisma/schema.prisma).
# Do not point this at a shared/production database for local development.
DATABASE_URL = "postgresql://user:password@host/dbname?sslmode=require"
