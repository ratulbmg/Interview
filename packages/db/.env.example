# Postgres connection string. Resolved relative to this file's own location
# (see src/index.ts), which is why it lives here instead of in apps/api's
# .env even though apps/api is the only app that talks to the database
# directly.
#
# For Docker dev (`yarn dev`), docker-compose.dev.yml injects its own
# DATABASE_URL pointing at the local `db` container and this file is
# ignored — you don't need to fill this in for that path.
#
# For native dev (`yarn dev:local`), this value is what actually gets used.
# Point it at a Postgres instance you control — e.g. the same local
# container Docker dev uses, started standalone:
#   docker compose -f ../../docker-compose.dev.yml up -d db
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interview"
# Do not point this at a shared/production database for local development.
DATABASE_URL = "postgresql://postgres:postgres@localhost:5432/interview"
