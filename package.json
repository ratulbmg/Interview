{
  "name": "ai-interview-platform",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "docker compose -f docker-compose.dev.yml up --build",
    "dev:local": "turbo run dev",
    "start": "turbo run start",
    "prepare": "husky",
    "lint:check": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,md}\"",
    "agent:build": "cd apps/interview-agent && python3 -m venv .venv && .venv/bin/pip install -e .",
    "db:generate": "docker compose -f docker-compose.dev.yml exec api yarn workspace @repo/db db-generate",
    "db:migrate": "docker compose -f docker-compose.dev.yml exec api yarn workspace @repo/db db-migrate",
    "db:seed": "docker compose -f docker-compose.dev.yml exec api yarn workspace @repo/db db-seed",
    "db:reset": "docker compose -f docker-compose.dev.yml exec api yarn workspace @repo/db db-reset",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:dev:rebuild": "docker compose -f docker-compose.dev.yml build --no-cache"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint"
    ],
    "*.{ts,tsx,md}": [
      "prettier --check"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "yarn",
      "version": "4.11.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  }
}
