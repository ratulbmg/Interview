FROM python:3.12-slim

WORKDIR /app

# Dependency manifest only, first — so this layer only rebuilds when
# pyproject.toml actually changes, same caching strategy as the Node images.
COPY apps/interview-agent/pyproject.toml ./

# Editable install needs at least one importable package present to resolve
# — the real source is bind-mounted over this at runtime (see
# docker-compose.dev.yml), same pattern as the Node apps' dev images.
COPY apps/interview-agent/agent ./agent
RUN pip install --no-cache-dir -e .

# WebRTC voice room (see agent/voice/server.py)
EXPOSE 7860
