FROM node:22-alpine

WORKDIR /app

RUN corepack enable && corepack prepare yarn@4.11.0 --activate

# Dependency manifests (same caching strategy as the API)
COPY package.json yarn.lock .yarnrc.yml ./

COPY apps/api/package.json           ./apps/api/
COPY apps/dashboard/package.json     ./apps/dashboard/
COPY apps/email-worker/package.json  ./apps/email-worker/
COPY packages/db/package.json        ./packages/db/
COPY packages/ui/package.json        ./packages/ui/
COPY packages/email/package.json     ./packages/email/
COPY packages/enums/package.json     ./packages/enums/
COPY packages/shared-schemas/package.json ./packages/shared-schemas/
COPY packages/eslint-config/         ./packages/eslint-config/
COPY packages/prettier-config/       ./packages/prettier-config/
COPY packages/typescript-config/     ./packages/typescript-config/

RUN yarn install --immutable && yarn cache clean

# Vite dev server port (see apps/dashboard/vite.config.ts)
EXPOSE 3002
