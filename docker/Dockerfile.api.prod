FROM node:22-alpine

WORKDIR /app

RUN corepack enable && corepack prepare yarn@4.11.0 --activate

# Copy dependency manifests
COPY package.json yarn.lock .yarnrc.yml ./
COPY apps/api/package.json          ./apps/api/
COPY packages/db/package.json       ./packages/db/
COPY packages/enums/package.json    ./packages/enums/
COPY packages/eslint-config/        ./packages/eslint-config/
COPY packages/prettier-config/      ./packages/prettier-config/
COPY packages/typescript-config/    ./packages/typescript-config/

# Install all workspace dependencies. `tsx` (which the API runs on, see
# below) is a devDependency, so this deliberately isn't a --production
# install.
RUN yarn install && yarn cache clean

# Copy source for the packages the API actually needs at runtime
COPY packages/db/    ./packages/db/
COPY packages/enums/ ./packages/enums/
COPY apps/api/        ./apps/api/

# The API imports the generated client straight from
# packages/db/generated/prisma — it has to exist before the app can boot.
# Doesn't need a live DATABASE_URL: `prisma generate` only reads the schema.
RUN yarn workspace @repo/db db-generate

EXPOSE 3001

# Runs the TypeScript source directly via tsx rather than a tsc build:
# @repo/db is consumed as .ts source (see its package.json "exports"), which
# plain compiled JS can't `require` without also compiling every workspace
# it touches — tsx sidesteps that instead of taking on a bigger build change.
CMD ["yarn", "workspace", "api", "start"]
